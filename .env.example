# Database
DATABASE_URL="postgresql://agendamento:CHANGE_ME@postgres-agendamento:5432/agendamento"

# Next.js
PORT=3000
HOSTNAME=0.0.0.0

# Domain (URLs absolutas pro Fluxi)
NEXT_PUBLIC_BASE_URL="https://agendamento.bcsgarcia.pt"

# API key para o endpoint público /api/public/catalogo-rastelli (consumido pelo Fluxi).
# Mesmo valor precisa estar configurado no Fluxi como CATALOGO_API_KEY.
# Gere com: openssl rand -hex 32 (mínimo 16 chars; recomendado 64 hex chars)
CATALOGO_API_KEY=""

# ──────────────────────────────────────────────────────────────────────
# Web Push (notificações de urgência) — 2026-08-25
# ──────────────────────────────────────────────────────────────────────
# Gere chaves com:  npx web-push generate-vapid-keys
# Chave pública é exposta ao browser (precisa estar como NEXT_PUBLIC_*
# pro Next.js inlining); chave privada fica só no servidor.
# Sem essas vars, push fica desativado (com warning no log) — sistema
# continua funcionando (badge in-page e banner funcionam via polling).
#
# Bruno: gerar no Coolify (não commitar chaves reais). Comando local:
#   cd <repo-root> && npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CLAIMS_EMAIL="mailto:admin@bcsgarcia.pt"

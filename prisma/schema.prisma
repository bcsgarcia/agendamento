generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                String             @id @default(uuid())
  phone             String             @unique
  name              String?
  birthDate         DateTime?
  allergies         String?
  notes             String?
  preferredTime     String?
  tags              String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bookings          Booking[]
  conversationState ConversationState?
}

model Service {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String
  durationMin Int
  priceCents  Int
  active      Boolean   @default(true)
  bookings    Booking[]
}

model Booking {
  id          String    @id @default(uuid())
  customerId  String
  serviceId   String
  startsAt    DateTime
  endsAt      DateTime
  status      String    @default("scheduled")
  confirmedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id])
  service     Service   @relation(fields: [serviceId], references: [id])

  @@index([startsAt])
  @@index([customerId, startsAt])
}

model Course {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  modality          String
  description       String
  priceCents        Int
  durationMin       Int?
  cargaHorariaHoras Int?
  maxAlunos         Int?
  formaPagamento    String?
  paymentTerms      Json?
  purchaseUrl       String   @default("")
  active            Boolean  @default(true)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
  aulas             Aula[]

  @@index([active])
  @@index([slug])
}

model Aula {
  id            String      @id @default(uuid())
  courseId      String
  dataInicio    DateTime
  dataFim       DateTime
  vagasOcupadas Int         @default(0)
  /// Override opcional do limite de vagas. Quando NULL, usa Course.maxAlunos como default.
  maxAlunos     Int?
  status        String      @default("aberta")
  local         String?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  inscricoes    Inscricao[]

  @@index([courseId, dataInicio])
  @@index([status, dataInicio])
}

model Inscricao {
  id                 String    @id @default(uuid())
  aulaId             String
  nomeInscrito       String
  email              String?
  telefone           String?
  valorPago          Int?
  sinalPago          Boolean   @default(false)
  dataSinal          DateTime?
  dataPagamentoFinal DateTime?
  statusPagamento    String    @default("pendente")
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
  aula               Aula      @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@index([aulaId])
  @@index([statusPagamento])
  @@index([aulaId, statusPagamento])
}

model UrgentQueue {
  id              String    @id @default(uuid())
  customerId      String?
  reason          String
  contextSnapshot String
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?

  @@index([resolvedAt, createdAt])
}

model ConversationState {
  id              String    @id @default(uuid())
  customerId      String    @unique
  state           String    @default("bot_ativo")
  lastClientMsgAt DateTime?
  lastHumanMsgAt  DateTime?
  lastBotMsgAt    DateTime?
  contextSummary  String?
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id])
}

model Whitelist {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  notes        String?
  active       Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model FeatureFlag {
  id           String   @id @default(uuid())
  nome         String   @unique
  ativo        Boolean  @default(false)
  descricao    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  customerId String?
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessions Session[]

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
